<roblox version="4">
<Item class="ModuleScript" referent="RBX0">
<Properties>
<string name="Name">GameplayCore</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	GameplayCore  =  GameplayTags + StatSystem in one package.

	The "glue" between your gameplay modules: instead of every module keeping its own
	booleans (isStunned, isBlocking...) and speed multipliers, they all read/write the
	same Tags and Stats of an entity.

	  local Core = require(ReplicatedStorage.GameplayCore)

	  Core.Tags.Define({ State = { Stunned = true, Blocking = true } })   -- optional but recommended
	  local entity = Core.Attach(character, { stats = { Speed = 16, MaxHealth = 100 } })

	  entity.Tags:Add("State.Stunned", "StunHandler", 2)                    -- tag, source, duration
	  entity.Stats:AddModifier("Speed", { type = "Mult", value = 0.5, source = "Slow", duration = 3 })
	  entity.Stats:Get("Speed")

	  Core.Get(character)       -- from any other module
	  Core.Detach(character)    -- (automatic when the Instance is destroyed)
]]

local Signal = require(script.Signal)
local TagRegistry = require(script.TagRegistry)
local TagContainer = require(script.TagContainer)
local StatContainer = require(script.StatContainer)

export type TagQuery = TagContainer.TagQuery
export type ModifierDef = StatContainer.ModifierDef
export type StatDef = StatContainer.StatDef
export type ModifierType = StatContainer.ModifierType
export type Stacking = StatContainer.Stacking

export type EntityConfig = {
	stats: { [string]: StatContainer.StatDef | number }?,
	strictStats: boolean?,
}

--------------------------------------------------------------------------------
-- Entity = one TagContainer + one StatContainer, already linked together
--------------------------------------------------------------------------------

local Entity = {}
Entity.__index = Entity

local entities = {} -- owner -> Entity

function Entity:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	entities[self.Owner] = nil
	if self._destroyConnection ~= nil then
		self._destroyConnection:Disconnect()
		self._destroyConnection = nil
	end
	self.Stats:Destroy() -- first: it listens to the tags
	self.Tags:Destroy()
end

local GameplayCore = {}

GameplayCore.Signal = Signal
GameplayCore.Tags = TagRegistry -- static: Define / Register / SetStrict / IsChildOf ...
GameplayCore.TagContainer = TagContainer -- .new(owner?)
GameplayCore.StatContainer = StatContainer -- .new(config?)

-- Create (or return the existing) entity for `owner` (an Instance or any table/value used as key).
function GameplayCore.Attach(owner: any, config: EntityConfig?)
	local existing = entities[owner]
	if existing ~= nil then
		return existing
	end

	config = config or {}

	local tags = TagContainer.new(owner)
	local stats = StatContainer.new({
		owner = owner,
		tags = tags,
		stats = config.stats,
		strict = config.strictStats,
	})

	local entity = setmetatable({
		Owner = owner,
		Tags = tags,
		Stats = stats,
		_destroyed = false,
		_destroyConnection = nil,
	}, Entity)

	if typeof(owner) == "Instance" then
		entity._destroyConnection = owner.Destroying:Connect(function()
			entity:Destroy()
		end)
	end

	entities[owner] = entity
	return entity
end

function GameplayCore.Get(owner: any)
	return entities[owner]
end

function GameplayCore.Has(owner: any): boolean
	return entities[owner] ~= nil
end

function GameplayCore.Detach(owner: any)
	local entity = entities[owner]
	if entity ~= nil then
		entity:Destroy()
	end
end

return GameplayCore
]]></ProtectedString>
</Properties>
<Item class="ModuleScript" referent="RBX1">
<Properties>
<string name="Name">Signal</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	Signal
	Tiny and fast event class: doubly linked list of connections + a reusable
	runner thread (no coroutine created per handler call).

	local signal = Signal.new()
	local conn = signal:Connect(function(a, b) end)
	signal:Once(function() end)
	signal:Fire(1, 2)
	signal:Wait()               -- yields until the next Fire, returns its arguments
	conn:Disconnect()
	signal:DisconnectAll()
	signal:Destroy()
]]

local Signal = {}
Signal.__index = Signal

local Connection = {}
Connection.__index = Connection

-- One thread is reused to run handlers. If a handler yields, the thread is
-- "lost" for that call and a new one is created on the next Fire.
local freeRunnerThread = nil

local function acquireRunnerThreadAndCallHandler(fn, ...)
	local acquired = freeRunnerThread
	freeRunnerThread = nil
	fn(...)
	-- Handler finished without yielding: the runner is free again.
	freeRunnerThread = acquired
end

local function runHandlerInFreeThread(...)
	acquireRunnerThreadAndCallHandler(...)
	while true do
		acquireRunnerThreadAndCallHandler(coroutine.yield())
	end
end

function Signal.new()
	return setmetatable({ _head = nil, _tail = nil }, Signal)
end

function Signal:Connect(fn)
	local connection = setmetatable({
		Connected = true,
		_fn = fn,
		_signal = self,
		_prev = self._tail,
		_next = nil,
	}, Connection)

	if self._tail then
		self._tail._next = connection
	else
		self._head = connection
	end
	self._tail = connection

	return connection
end

function Signal:Once(fn)
	local connection
	connection = self:Connect(function(...)
		if connection.Connected then
			connection:Disconnect()
			fn(...)
		end
	end)
	return connection
end

function Signal:Wait()
	local thread = coroutine.running()
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:Fire(...)
	local item = self._head
	while item do
		if item.Connected then
			if not freeRunnerThread then
				freeRunnerThread = coroutine.create(runHandlerInFreeThread)
			end
			task.spawn(freeRunnerThread, item._fn, ...)
		end
		-- _next is intentionally kept after Disconnect so iteration stays valid.
		item = item._next
	end
end

function Signal:HasConnections(): boolean
	return self._head ~= nil
end

function Signal:DisconnectAll()
	local item = self._head
	while item do
		item.Connected = false
		item = item._next
	end
	self._head = nil
	self._tail = nil
end

function Signal:Destroy()
	self:DisconnectAll()
end

function Connection:Disconnect()
	if not self.Connected then
		return
	end
	self.Connected = false

	local signal = self._signal
	local prev, nxt = self._prev, self._next
	if prev then
		prev._next = nxt
	else
		signal._head = nxt
	end
	if nxt then
		nxt._prev = prev
	else
		signal._tail = prev
	end
end

return Signal
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX2">
<Properties>
<string name="Name">Ticker</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	Ticker (internal)
	ONE shared Heartbeat connection for every container that owns timed entries
	(timed tags, timed modifiers). The connection only exists while at least one
	container is waiting for an expiry, so idle containers cost nothing.

	A registered object must expose:
	  obj._nextExpiry : number      -- earliest Ticker.Now() time at which something expires
	  obj:_Expire(now : number)     -- called once now >= _nextExpiry
]]

local RunService = game:GetService("RunService")

local Ticker = {}

local list = {}
local indexOf = {}
local connection = nil

local function step()
	local now = os.clock()
	-- Backwards + swap-remove: removing the current entry while iterating is safe.
	for i = #list, 1, -1 do
		local obj = list[i]
		if obj ~= nil and now >= obj._nextExpiry then
			obj:_Expire(now)
		end
	end
end

function Ticker.Now(): number
	return os.clock()
end

function Ticker.Add(obj)
	if indexOf[obj] then
		return
	end
	local n = #list + 1
	list[n] = obj
	indexOf[obj] = n
	if connection == nil then
		connection = RunService.Heartbeat:Connect(step)
	end
end

function Ticker.Remove(obj)
	local i = indexOf[obj]
	if i == nil then
		return
	end
	local last = #list
	local lastObj = list[last]
	list[i] = lastObj
	indexOf[lastObj] = i
	list[last] = nil
	indexOf[obj] = nil

	if last == 1 and connection ~= nil then
		connection:Disconnect()
		connection = nil
	end
end

return Ticker
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX3">
<Properties>
<string name="Name">TagRegistry</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	TagRegistry
	Static helpers shared by every TagContainer:
	  * tag name validation + hierarchy ("State.Stunned.Hard" -> State / State.Stunned / State.Stunned.Hard)
	  * optional registry + strict mode (typo protection)

	Tags.Define({ State = { Stunned = { "Soft", "Hard" }, Blocking = true } })
	Tags.Register({ "Damage.Fire", "Damage.Ice" })
	Tags.SetStrict(true)    -- unknown tags now throw an error instead of silently working
]]

local MAX_DEPTH = 24 -- limited by the bitmask used in TagContainer

local TagRegistry = {}

-- Read directly by TagContainer on hot paths (cheaper than a function call).
TagRegistry.Strict = false

local registered: { [string]: boolean } = {}
local pathCache: { [string]: { string } } = {}

local function buildPath(tag: any): { string }
	if type(tag) ~= "string" then
		error(("Tag must be a string, got %s"):format(typeof(tag)), 0)
	end
	if
		tag == ""
		or string.find(tag, "^%.")
		or string.find(tag, "%.$")
		or string.find(tag, "%.%.")
		or string.find(tag, "[^%w_%.]")
	then
		error(
			("Invalid tag name %q. Use letters, digits, '_' and '.' as separator (e.g. \"State.Stunned.Hard\")."):format(tag),
			0
		)
	end

	local path = {}
	local position = 0
	while true do
		local dot = string.find(tag, ".", position + 1, true)
		if dot == nil then
			path[#path + 1] = tag
			break
		end
		path[#path + 1] = string.sub(tag, 1, dot - 1)
		position = dot
	end

	if #path > MAX_DEPTH then
		error(("Tag %q is too deep (max %d levels)"):format(tag, MAX_DEPTH), 0)
	end

	return table.freeze(path)
end

-- Returns the list of prefixes of a tag. The result is cached and frozen.
function TagRegistry.GetPath(tag: string): { string }
	local cached = pathCache[tag]
	if cached ~= nil then
		return cached
	end
	local path = buildPath(tag)
	pathCache[tag] = path
	return path
end

local function registerOne(tag: string)
	local path = TagRegistry.GetPath(tag)
	for i = 1, #path do
		registered[path[i]] = true
	end
end

-- Register one tag or a list of tags (parents are registered automatically).
function TagRegistry.Register(tags: string | { string })
	if type(tags) == "string" then
		registerOne(tags)
	else
		for _, tag in tags do
			registerOne(tag)
		end
	end
end

-- Register a whole tree in one go.
--   { State = { Stunned = { "Soft", "Hard" }, Blocking = true } }
-- registers State, State.Stunned, State.Stunned.Soft, State.Stunned.Hard, State.Blocking
local function walk(prefix: string, node: any)
	for key, value in node do
		if type(key) == "number" then
			registerOne(prefix .. tostring(value))
		else
			local full = prefix .. key
			registerOne(full)
			if type(value) == "table" then
				walk(full .. ".", value)
			end
		end
	end
end

function TagRegistry.Define(tree: { [any]: any })
	walk("", tree)
end

function TagRegistry.IsRegistered(tag: string): boolean
	return registered[tag] == true
end

function TagRegistry.GetAll(): { string }
	local list = {}
	for tag in registered do
		list[#list + 1] = tag
	end
	table.sort(list)
	return list
end

function TagRegistry.SetStrict(enabled: boolean)
	TagRegistry.Strict = enabled
end

-- Validates a tag name and, in strict mode, checks it was registered.
function TagRegistry.Check(tag: string)
	TagRegistry.GetPath(tag) -- validates the name (cached afterwards)
	if TagRegistry.Strict and not registered[tag] then
		error(
			("Unknown tag %q (strict mode). Declare it with Tags.Define / Tags.Register first."):format(tag),
			0
		)
	end
end

-- true if `tag` is `parent` or one of its descendants.
function TagRegistry.IsChildOf(tag: string, parent: string): boolean
	return tag == parent or string.sub(tag, 1, #parent + 1) == parent .. "."
end

-- "State.Stunned.Hard" -> "State.Stunned" (nil for a root tag)
function TagRegistry.GetParent(tag: string): string?
	local path = TagRegistry.GetPath(tag)
	return path[#path - 1]
end

return TagRegistry
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX4">
<Properties>
<string name="Name">TagContainer</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	TagContainer
	The set of gameplay tags currently held by ONE entity (character, NPC, tool...).

	Key ideas
	  * Hierarchical: holding "State.Stunned.Hard" also counts as holding "State.Stunned" and "State".
	  * Source-based: every Add is tied to a source (a system, an item, a skill...).
	    A tag stays as long as at least one source holds it.
	  * Timed: Add(tag, source, duration) removes itself automatically.
	  * O(1) queries thanks to a pre-computed "present" counter per prefix.
	  * Events: TagAdded / TagRemoved / Changed, plus Observe() on any (parent) tag.

	Events fire AFTER the container state is fully updated, so handlers always see
	a consistent container.
]]

local Signal = require(script.Parent.Signal)
local Ticker = require(script.Parent.Ticker)
local TagRegistry = require(script.Parent.TagRegistry)

export type TagQuery = {
	all: { string }?, -- every tag must be present
	any: { string }?, -- at least one tag must be present
	none: { string }?, -- no tag may be present
}

local DEFAULT_SOURCE = "Default"
local INF = math.huge

local TagContainer = {}
TagContainer.__index = TagContainer

function TagContainer.new(owner: any?)
	local self = setmetatable({}, TagContainer)

	self.Owner = owner
	self.TagAdded = Signal.new() -- (tag)           explicit tag appeared
	self.TagRemoved = Signal.new() -- (tag)           explicit tag disappeared
	self.Changed = Signal.new() -- (tag, present)  either of the two above

	self._entries = {} -- tag -> { [source] = expiresAt }
	self._counts = {} -- tag -> number of sources holding it (explicit tags only)
	self._present = {} -- tag/prefix -> number of explicit tags at or below it
	self._watchers = {} -- tag/prefix -> Signal(present: boolean)
	self._timed = {} -- { {tag, source, expiresAt} }
	self._nextExpiry = INF
	self._destroyed = false

	return self
end

--------------------------------------------------------------------------------
-- Internal state transitions
--------------------------------------------------------------------------------

-- An explicit tag went from 0 to 1 source.
function TagContainer:_Appear(tag: string)
	local path = TagRegistry.GetPath(tag)
	local present = self._present

	-- bit i set = prefix i just became present
	local mask = 0
	for i = 1, #path do
		local prefix = path[i]
		local n = present[prefix]
		if n == nil then
			mask = bit32.bor(mask, bit32.lshift(1, i - 1))
			present[prefix] = 1
		else
			present[prefix] = n + 1
		end
	end

	local watchers = self._watchers
	for i = 1, #path do
		if bit32.btest(mask, bit32.lshift(1, i - 1)) then
			local watcher = watchers[path[i]]
			if watcher ~= nil then
				watcher:Fire(true)
			end
		end
	end

	self.TagAdded:Fire(tag)
	self.Changed:Fire(tag, true)
end

-- An explicit tag went from 1 to 0 sources.
function TagContainer:_Vanish(tag: string)
	local path = TagRegistry.GetPath(tag)
	local present = self._present

	local mask = 0
	for i = 1, #path do
		local prefix = path[i]
		local n = present[prefix] - 1
		if n <= 0 then
			present[prefix] = nil
			mask = bit32.bor(mask, bit32.lshift(1, i - 1))
		else
			present[prefix] = n
		end
	end

	local watchers = self._watchers
	for i = #path, 1, -1 do -- leaf first
		if bit32.btest(mask, bit32.lshift(1, i - 1)) then
			local watcher = watchers[path[i]]
			if watcher ~= nil then
				watcher:Fire(false)
			end
		end
	end

	self.TagRemoved:Fire(tag)
	self.Changed:Fire(tag, false)
end

function TagContainer:_Track(tag: string, source: any, expiresAt: number)
	table.insert(self._timed, { tag = tag, source = source, expiresAt = expiresAt })
	if expiresAt < self._nextExpiry then
		self._nextExpiry = expiresAt
	end
	Ticker.Add(self)
end

-- Called by the Ticker once something may have expired.
function TagContainer:_Expire(now: number)
	local keep = {}
	local expired = nil
	local nextExpiry = INF

	for _, item in self._timed do
		local sources = self._entries[item.tag]
		local current = if sources ~= nil then sources[item.source] else nil

		if current ~= item.expiresAt then
			-- stale: the entry was removed or refreshed since this item was queued
		elseif item.expiresAt <= now then
			expired = expired or {}
			table.insert(expired, item)
		else
			table.insert(keep, item)
			if item.expiresAt < nextExpiry then
				nextExpiry = item.expiresAt
			end
		end
	end

	self._timed = keep
	self._nextExpiry = nextExpiry
	if #keep == 0 then
		Ticker.Remove(self)
	end

	if expired ~= nil then
		for _, item in expired do
			self:_RemoveEntry(item.tag, item.source)
		end
	end
end

function TagContainer:_RemoveEntry(tag: string, source: any): boolean
	local entries = self._entries[tag]
	if entries == nil or entries[source] == nil then
		return false
	end

	entries[source] = nil
	local count = self._counts[tag] - 1
	if count <= 0 then
		self._counts[tag] = nil
		self._entries[tag] = nil
		self:_Vanish(tag)
	else
		self._counts[tag] = count
	end
	return true
end

--------------------------------------------------------------------------------
-- Writing
--------------------------------------------------------------------------------

--[[
	Add a tag.
	  tag      "State.Stunned.Hard"
	  source   who owns this tag (string / Instance / table). Default: "Default"
	  duration seconds before automatic removal (nil = permanent)

	Adding the same (tag, source) again refreshes it and keeps the LONGEST duration
	(a permanent entry stays permanent).
]]
function TagContainer:Add(tag: string, source: any?, duration: number?)
	if self._destroyed then
		return
	end
	TagRegistry.Check(tag)
	if source == nil then
		source = DEFAULT_SOURCE
	end

	local expiresAt = INF
	if duration ~= nil then
		if type(duration) ~= "number" or duration <= 0 or duration ~= duration then
			error("Tag duration must be a positive number (or nil for a permanent tag)", 2)
		end
		if duration ~= INF then
			expiresAt = Ticker.Now() + duration
		end
	end

	local entries = self._entries[tag]
	if entries == nil then
		entries = {}
		self._entries[tag] = entries
	end

	local current = entries[source]
	if current ~= nil then
		-- Refresh: keep the longest lifetime.
		if expiresAt > current then
			entries[source] = expiresAt
			if expiresAt ~= INF then
				self:_Track(tag, source, expiresAt)
			end
		end
		return
	end

	entries[source] = expiresAt
	if expiresAt ~= INF then
		self:_Track(tag, source, expiresAt)
	end

	local count = (self._counts[tag] or 0) + 1
	self._counts[tag] = count
	if count == 1 then
		self:_Appear(tag)
	end
end

-- Remove the tag held by `source` (default source if omitted). Returns true if something was removed.
function TagContainer:Remove(tag: string, source: any?): boolean
	if source == nil then
		source = DEFAULT_SOURCE
	end
	return self:_RemoveEntry(tag, source)
end

-- Remove every tag held by `source`. Returns how many tags were removed.
function TagContainer:RemoveAllFromSource(source: any): number
	local targets = {}
	for tag, entries in self._entries do
		if entries[source] ~= nil then
			targets[#targets + 1] = tag
		end
	end
	local removed = 0
	for _, tag in targets do
		if self:_RemoveEntry(tag, source) then
			removed += 1
		end
	end
	return removed
end

-- Force-remove a tag whatever its sources. Returns true if it was present.
function TagContainer:RemoveTag(tag: string): boolean
	if self._entries[tag] == nil then
		return false
	end
	self._entries[tag] = nil
	self._counts[tag] = nil
	self:_Vanish(tag)
	return true
end

-- Force-remove a tag and all its descendants ("State.Stunned" removes "State.Stunned.Hard" too).
function TagContainer:RemoveTagTree(tag: string): number
	local targets = {}
	for explicit in self._counts do
		if TagRegistry.IsChildOf(explicit, tag) then
			targets[#targets + 1] = explicit
		end
	end
	for _, explicit in targets do
		self:RemoveTag(explicit)
	end
	return #targets
end

function TagContainer:Clear()
	local targets = {}
	for tag in self._counts do
		targets[#targets + 1] = tag
	end
	for _, tag in targets do
		self:RemoveTag(tag)
	end
end

--------------------------------------------------------------------------------
-- Reading
--------------------------------------------------------------------------------

-- Hierarchical check: Has("State.Stunned") is true if "State.Stunned.Hard" is held.
function TagContainer:Has(tag: string): boolean
	if TagRegistry.Strict then
		TagRegistry.Check(tag)
	end
	return self._present[tag] ~= nil
end

-- Exact check: only true if this precise tag was added.
function TagContainer:HasExact(tag: string): boolean
	return self._counts[tag] ~= nil
end

function TagContainer:HasAny(tags: { string }): boolean
	for i = 1, #tags do
		if self:Has(tags[i]) then
			return true
		end
	end
	return false
end

function TagContainer:HasAll(tags: { string }): boolean
	for i = 1, #tags do
		if not self:Has(tags[i]) then
			return false
		end
	end
	return true
end

-- Like Has, but also accepts "Parent.*" = at least one STRICT descendant of Parent.
function TagContainer:Matches(pattern: string): boolean
	if string.sub(pattern, -2) == ".*" then
		local prefix = string.sub(pattern, 1, -3)
		local total = self._present[prefix] or 0
		local self_ = if self._counts[prefix] ~= nil then 1 else 0
		return total - self_ > 0
	end
	return self:Has(pattern)
end

-- Evaluates { all = {...}, any = {...}, none = {...} } (all fields optional, wildcards allowed).
function TagContainer:Satisfies(query: TagQuery): boolean
	local all = query.all
	if all ~= nil then
		for i = 1, #all do
			if not self:Matches(all[i]) then
				return false
			end
		end
	end

	local none = query.none
	if none ~= nil then
		for i = 1, #none do
			if self:Matches(none[i]) then
				return false
			end
		end
	end

	local any = query.any
	if any ~= nil and #any > 0 then
		for i = 1, #any do
			if self:Matches(any[i]) then
				return true
			end
		end
		return false
	end

	return true
end

-- How many distinct sources hold this exact tag.
function TagContainer:GetCount(tag: string): number
	return self._counts[tag] or 0
end

function TagContainer:GetSources(tag: string): { any }
	local list = {}
	local entries = self._entries[tag]
	if entries ~= nil then
		for source in entries do
			list[#list + 1] = source
		end
	end
	return list
end

-- Seconds left for (tag, source). nil = permanent or not present.
function TagContainer:GetTimeLeft(tag: string, source: any?): number?
	if source == nil then
		source = DEFAULT_SOURCE
	end
	local entries = self._entries[tag]
	local expiresAt = if entries ~= nil then entries[source] else nil
	if expiresAt == nil or expiresAt == INF then
		return nil
	end
	return math.max(0, expiresAt - Ticker.Now())
end

-- Explicit tags (sorted).
function TagContainer:GetTags(): { string }
	local list = {}
	for tag in self._counts do
		list[#list + 1] = tag
	end
	table.sort(list)
	return list
end

-- Explicit tags that are `prefix` or below it.
function TagContainer:GetTagsUnder(prefix: string): { string }
	local list = {}
	for tag in self._counts do
		if TagRegistry.IsChildOf(tag, prefix) then
			list[#list + 1] = tag
		end
	end
	table.sort(list)
	return list
end

--------------------------------------------------------------------------------
-- Observing
--------------------------------------------------------------------------------

-- callback(present: boolean) is called immediately, then each time `tag` (or any
-- descendant) appears for the first time / disappears completely.
function TagContainer:Observe(tag: string, callback: (present: boolean) -> ())
	TagRegistry.Check(tag)
	local watcher = self._watchers[tag]
	if watcher == nil then
		watcher = Signal.new()
		self._watchers[tag] = watcher
	end
	callback(self._present[tag] ~= nil)
	return watcher:Connect(callback)
end

-- Yields until `tag` is present (returns true) or `timeout` seconds passed (returns false).
function TagContainer:WaitFor(tag: string, timeout: number?): boolean
	if self:Has(tag) then
		return true
	end
	local thread = coroutine.running()
	local done = false
	local connection
	connection = self:Observe(tag, function(present)
		if present and not done then
			done = true
			connection:Disconnect()
			task.spawn(thread, true)
		end
	end)
	if timeout ~= nil then
		task.delay(timeout, function()
			if not done then
				done = true
				connection:Disconnect()
				task.spawn(thread, false)
			end
		end)
	end
	return coroutine.yield()
end

--------------------------------------------------------------------------------
-- Replication helpers (transport is up to you: RemoteEvent, Blink, ByteNet...)
--------------------------------------------------------------------------------

-- List of explicit tags, ready to be sent to a client.
function TagContainer:Serialize(): { string }
	return self:GetTags()
end

-- Makes this container hold exactly `tags` for `source` (diff-based, fires only real changes).
-- Meant for the CLIENT side of a replication.
function TagContainer:ApplySnapshot(tags: { string }, source: any?)
	if source == nil then
		source = "Replicated"
	end

	local wanted = {}
	for _, tag in tags do
		wanted[tag] = true
		self:Add(tag, source)
	end

	local stale = {}
	for tag, entries in self._entries do
		if entries[source] ~= nil and not wanted[tag] then
			stale[#stale + 1] = tag
		end
	end
	for _, tag in stale do
		self:_RemoveEntry(tag, source)
	end
end

--------------------------------------------------------------------------------
-- Debug / lifecycle
--------------------------------------------------------------------------------

function TagContainer:Dump(): string
	local lines = {}
	local now = Ticker.Now()
	for _, tag in self:GetTags() do
		local parts = {}
		for source, expiresAt in self._entries[tag] do
			local label = tostring(source)
			if expiresAt ~= INF then
				label ..= string.format(" (%.1fs)", expiresAt - now)
			end
			parts[#parts + 1] = label
		end
		table.sort(parts)
		lines[#lines + 1] = tag .. "  <-  " .. table.concat(parts, ", ")
	end
	if #lines == 0 then
		return "(no tags)"
	end
	return table.concat(lines, "\n")
end

function TagContainer:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	Ticker.Remove(self)
	self._entries = {}
	self._counts = {}
	self._present = {}
	self._timed = {}
	for _, watcher in self._watchers do
		watcher:Destroy()
	end
	self._watchers = {}
	self.TagAdded:Destroy()
	self.TagRemoved:Destroy()
	self.Changed:Destroy()
end

return TagContainer
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX5">
<Properties>
<string name="Name">StatContainer</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	StatContainer
	All numeric stats of ONE entity (Speed, Damage, MaxHealth, CritChance...).

	Final value pipeline (inspired by Path of Exile / Unreal GAS):

	    value = (base + sum(Flat)) * (1 + sum(Increase)) * product(Mult)
	    if an Override exists  -> value = the Override with the highest priority
	    then clamp(min, max) and rounding

	  Flat      +N                       value = 5      -> +5
	  Increase  +% (additive pool)       value = 0.25   -> +25%  (two 25% make +50%)
	  Mult      x factor (multiplicative) value = 1.2    -> x1.2  (two 1.2 make x1.44)
	  Override  forces the result        value = 0      -> stat = 0 (ex: Speed 0 when rooted)

	Features
	  * every modifier remembers its Source -> RemoveBySource("Potion") in one call
	  * duration (auto expire), stacking (Replace / Stack / Refresh / Ignore)
	  * conditional modifiers: only active while a TagQuery is satisfied
	  * derived stats with auto dependency tracking (formula)
	  * lazy + cached: nothing is recomputed until you Get() it
	  * change events are batched and deferred (one event per frame per stat, max)
]]

local Signal = require(script.Parent.Signal)
local Ticker = require(script.Parent.Ticker)

export type ModifierType = "Flat" | "Increase" | "Mult" | "Override"
export type Stacking = "Replace" | "Stack" | "Refresh" | "Ignore"

export type TagQuery = {
	all: { string }?,
	any: { string }?,
	none: { string }?,
}

export type ModifierDef = {
	type: ModifierType,
	value: number,
	source: any?, -- who applied it (default "Unknown")
	key: string?, -- with `source`, identifies "the same effect" for stacking
	stacking: Stacking?, -- only used when `key` is set (default "Replace")
	maxStacks: number?, -- for stacking = "Stack"
	duration: number?, -- seconds, nil = permanent
	priority: number?, -- for Override (highest wins, default 0)
	condition: TagQuery?, -- needs a TagContainer linked to the StatContainer
}

export type StatDef = {
	base: number?,
	min: number?,
	max: number?,
	rounding: ("floor" | "ceil" | "round")?,
	formula: ((get: (stat: string) -> number) -> number)?, -- derived base value
}

export type Config = {
	owner: any?,
	tags: any?, -- TagContainer
	stats: { [string]: StatDef | number }?, -- a number is a shortcut for { base = number }
	strict: boolean?, -- true = unknown stats throw instead of being created with base 0
}

local INF = math.huge

local VALID_TYPES = { Flat = true, Increase = true, Mult = true, Override = true }
local VALID_STACKING = { Replace = true, Stack = true, Refresh = true, Ignore = true }

--------------------------------------------------------------------------------
-- Modifier handle
--------------------------------------------------------------------------------

local Modifier = {}
Modifier.__index = Modifier

function Modifier:IsActive(): boolean
	return self._owner ~= nil
end

function Modifier:Remove(): boolean
	local owner = self._owner
	if owner == nil then
		return false
	end
	owner:_RemoveModifier(self)
	return true
end

function Modifier:SetValue(value: number)
	local owner = self._owner
	if owner == nil then
		return
	end
	self.Value = value
	owner:_MarkDirty(owner._records[self.Stat])
end

-- nil = make it permanent
function Modifier:SetDuration(duration: number?)
	local owner = self._owner
	if owner == nil then
		return
	end
	owner:_SetExpiry(self, duration)
end

function Modifier:GetTimeLeft(): number?
	if self._owner == nil or self.ExpiresAt == INF then
		return nil
	end
	return math.max(0, self.ExpiresAt - Ticker.Now())
end

--------------------------------------------------------------------------------
-- StatContainer
--------------------------------------------------------------------------------

local StatContainer = {}
StatContainer.__index = StatContainer

function StatContainer.new(config: Config?)
	config = config or {}

	local self = setmetatable({}, StatContainer)
	self.Owner = config.owner
	self.Changed = Signal.new() -- (stat: string, new: number, old: number)

	self._tags = config.tags
	self._strict = config.strict == true
	self._records = {}
	self._pending = {}
	self._flushScheduled = false
	self._timed = {}
	self._nextExpiry = INF
	self._conditional = {} -- set of records that own at least one conditional modifier
	self._nextId = 0
	self._destroyed = false
	self._tagConnection = nil

	self._deferredFlush = function()
		self._flushScheduled = false
		if not self._destroyed then
			self:Flush()
		end
	end

	if self._tags ~= nil then
		-- Conditional modifiers depend on tags: any tag change re-validates them.
		self._tagConnection = self._tags.Changed:Connect(function()
			for rec in self._conditional do
				self:_MarkDirty(rec)
			end
		end)
	end

	if config.stats ~= nil then
		for name, def in config.stats do
			self:Define(name, def)
		end
	end

	return self
end

-- Create or redefine a stat.
function StatContainer:Define(name: string, def: (StatDef | number)?)
	if type(def) == "number" then
		def = { base = def }
	end
	def = def or {}

	local rec = self._records[name]
	if rec == nil then
		rec = {
			name = name,
			mods = {},
			dependents = {}, -- records whose formula reads this stat
			dirty = true,
			queued = false,
			computing = false,
			conditionalCount = 0,
		}
		rec.getter = function(dependencyName: string): number
			local dependency = self:_GetRecord(dependencyName)
			dependency.dependents[rec] = true
			if dependency.dirty then
				self:_Compute(dependency)
			end
			return dependency.cached
		end
		self._records[name] = rec
	end

	rec.base = def.base or 0
	rec.min = def.min
	rec.max = def.max
	rec.rounding = def.rounding
	rec.formula = def.formula

	self:_MarkDirty(rec)
end

function StatContainer:_GetRecord(name: string)
	local rec = self._records[name]
	if rec ~= nil then
		return rec
	end
	if type(name) ~= "string" then
		error(("Stat name must be a string, got %s"):format(typeof(name)), 3)
	end
	if self._strict then
		error(("Unknown stat %q (strict mode). Declare it in the `stats` config or with :Define()."):format(name), 3)
	end
	self:Define(name, {})
	return self._records[name]
end

--------------------------------------------------------------------------------
-- Computation
--------------------------------------------------------------------------------

function StatContainer:_Compute(rec)
	if rec.computing then
		error(("Cyclic stat formula detected on %q"):format(rec.name), 0)
	end
	rec.computing = true

	local base = rec.base
	local formula = rec.formula
	if formula ~= nil then
		local ok, result = pcall(formula, rec.getter)
		if not ok then
			rec.computing = false
			error(result, 0)
		end
		base = result
	end

	local flat, increase, mult = 0, 0, 1
	local overrideValue = nil
	local overridePriority, overrideId = -INF, -1
	local tags = self._tags

	for _, mod in rec.mods do
		local condition = mod.Condition
		if condition == nil or (tags ~= nil and tags:Satisfies(condition)) then
			local mtype = mod.Type
			if mtype == "Flat" then
				flat += mod.Value * mod.Stacks
			elseif mtype == "Increase" then
				increase += mod.Value * mod.Stacks
			elseif mtype == "Mult" then
				mult *= if mod.Stacks == 1 then mod.Value else mod.Value ^ mod.Stacks
			else
				local priority = mod.Priority
				if priority > overridePriority or (priority == overridePriority and mod.Id > overrideId) then
					overrideValue, overridePriority, overrideId = mod.Value, priority, mod.Id
				end
			end
		end
	end

	local value
	if overrideValue ~= nil then
		value = overrideValue
	else
		value = (base + flat) * math.max(0, 1 + increase) * mult
	end

	if rec.min ~= nil and value < rec.min then
		value = rec.min
	end
	if rec.max ~= nil and value > rec.max then
		value = rec.max
	end

	local rounding = rec.rounding
	if rounding == "floor" then
		value = math.floor(value)
	elseif rounding == "ceil" then
		value = math.ceil(value)
	elseif rounding == "round" then
		value = math.round(value)
	end

	rec.cached = value
	rec.dirty = false
	rec.computing = false
end

function StatContainer:_MarkDirty(rec)
	if not rec.dirty then
		rec.dirty = true
		-- Remember the last stable value, unless a notification is already pending
		-- (then `previous` is already the last value listeners were told about).
		if not rec.queued then
			rec.previous = rec.cached
		end
		for dependent in rec.dependents do
			self:_MarkDirty(dependent)
		end
	end

	if not rec.queued and (rec.signal ~= nil or self.Changed:HasConnections()) then
		rec.queued = true
		local pending = self._pending
		pending[#pending + 1] = rec
		if not self._flushScheduled then
			self._flushScheduled = true
			task.defer(self._deferredFlush)
		end
	end
end

-- Recompute queued stats and fire change events right now (normally done automatically, deferred).
function StatContainer:Flush()
	local pending = self._pending
	if #pending == 0 then
		return
	end
	self._pending = {}

	for _, rec in pending do
		rec.queued = false
		local old = rec.previous
		if rec.dirty then
			self:_Compute(rec)
		end
		local new = rec.cached
		if old ~= nil and new ~= old then
			if rec.signal ~= nil then
				rec.signal:Fire(new, old)
			end
			self.Changed:Fire(rec.name, new, old)
		end
	end
end

--------------------------------------------------------------------------------
-- Reading
--------------------------------------------------------------------------------

function StatContainer:Get(name: string): number
	local rec = self._records[name]
	if rec == nil then
		rec = self:_GetRecord(name)
	end
	if rec.dirty then
		self:_Compute(rec)
	end
	return rec.cached
end

-- Base value, before any modifier.
function StatContainer:GetBase(name: string): number
	return self:_GetRecord(name).base
end

function StatContainer:Has(name: string): boolean
	return self._records[name] ~= nil
end

-- Every stat -> final value. Handy for replication / saving.
function StatContainer:GetAll(): { [string]: number }
	local out = {}
	for name in self._records do
		out[name] = self:Get(name)
	end
	return out
end

-- Detailed view of one stat, perfect for tooltips and debugging.
function StatContainer:Breakdown(name: string)
	local rec = self:_GetRecord(name)
	local tags = self._tags
	local now = Ticker.Now()

	local base = rec.base
	if rec.formula ~= nil then
		base = self:_DerivedBase(rec)
	end

	local flat, increase, mult = 0, 0, 1
	local overrideValue, overridePriority, overrideId = nil, -INF, -1
	local list = {}
	for _, mod in rec.mods do
		local active = mod.Condition == nil or (tags ~= nil and tags:Satisfies(mod.Condition))
		if active then
			if mod.Type == "Flat" then
				flat += mod.Value * mod.Stacks
			elseif mod.Type == "Increase" then
				increase += mod.Value * mod.Stacks
			elseif mod.Type == "Mult" then
				mult *= mod.Value ^ mod.Stacks
			elseif
				mod.Priority > overridePriority
				or (mod.Priority == overridePriority and mod.Id > overrideId)
			then
				overrideValue, overridePriority, overrideId = mod.Value, mod.Priority, mod.Id
			end
		end
		list[#list + 1] = {
			Type = mod.Type,
			Value = mod.Value,
			Stacks = mod.Stacks,
			Source = mod.Source,
			Key = mod.Key,
			Priority = mod.Priority,
			ConditionMet = active,
			TimeLeft = if mod.ExpiresAt == INF then nil else math.max(0, mod.ExpiresAt - now),
		}
	end

	return {
		Name = name,
		Base = base,
		Flat = flat,
		Increase = increase,
		Mult = mult,
		Override = overrideValue, -- nil when no Override is active
		Min = rec.min,
		Max = rec.max,
		Value = self:Get(name),
		Modifiers = list,
	}
end

function StatContainer:_DerivedBase(rec): number
	local ok, result = pcall(rec.formula, rec.getter)
	if not ok then
		error(result, 0)
	end
	return result
end

--------------------------------------------------------------------------------
-- Base values
--------------------------------------------------------------------------------

function StatContainer:SetBase(name: string, value: number)
	local rec = self:_GetRecord(name)
	if rec.formula ~= nil then
		error(("Stat %q is derived (has a formula): its base cannot be set manually"):format(name), 2)
	end
	if type(value) ~= "number" or value ~= value then
		error("Base value must be a number", 2)
	end
	if rec.base ~= value then
		rec.base = value
		self:_MarkDirty(rec)
	end
end

function StatContainer:AddBase(name: string, delta: number)
	self:SetBase(name, self:_GetRecord(name).base + delta)
end

--------------------------------------------------------------------------------
-- Modifiers
--------------------------------------------------------------------------------

function StatContainer:_SetExpiryAbsolute(mod, expiresAt: number)
	mod.ExpiresAt = expiresAt
	if expiresAt ~= INF then
		if not mod._timed then
			mod._timed = true
			table.insert(self._timed, mod)
		end
		if expiresAt < self._nextExpiry then
			self._nextExpiry = expiresAt
		end
		Ticker.Add(self)
	end
end

function StatContainer:_SetExpiry(mod, duration: number?)
	if duration == nil or duration == INF then
		self:_SetExpiryAbsolute(mod, INF)
	else
		self:_SetExpiryAbsolute(mod, Ticker.Now() + duration)
	end
end

function StatContainer:_SetCondition(rec, mod, condition)
	local had = mod.Condition ~= nil
	mod.Condition = condition
	local has = condition ~= nil
	if has and not had then
		rec.conditionalCount += 1
		self._conditional[rec] = true
	elseif had and not has then
		rec.conditionalCount -= 1
		if rec.conditionalCount <= 0 then
			self._conditional[rec] = nil
		end
	end
end

--[[
	Add a modifier to a stat and return its handle (handle:Remove(), :SetValue(), :SetDuration()).

	stats:AddModifier("Speed", { type = "Mult", value = 1.2, source = "Potion", duration = 10 })

	With `key`, adding the same (source, key) again applies `stacking`:
	  Replace (default) overwrite the existing modifier in place
	  Stack             +1 stack (value is multiplied by stacks), up to `maxStacks`
	  Refresh           keep it, only reset the duration
	  Ignore            do nothing
]]
function StatContainer:AddModifier(statName: string, def: ModifierDef)
	if self._destroyed then
		error("StatContainer is destroyed", 2)
	end
	if type(def) ~= "table" then
		error("AddModifier expects a definition table", 2)
	end

	local mtype = def.type
	if not VALID_TYPES[mtype] then
		error(("Invalid modifier type %q (use Flat, Increase, Mult or Override)"):format(tostring(mtype)), 2)
	end
	local value = def.value
	if type(value) ~= "number" or value ~= value then
		error("Modifier `value` must be a number", 2)
	end
	if def.condition ~= nil and self._tags == nil then
		error("Modifier has a `condition` but this StatContainer has no TagContainer (pass `tags` in the config)", 2)
	end
	if def.stacking ~= nil and not VALID_STACKING[def.stacking] then
		error(("Invalid stacking mode %q"):format(tostring(def.stacking)), 2)
	end

	local rec = self:_GetRecord(statName)
	local source = def.source
	if source == nil then
		source = "Unknown"
	end

	local duration = def.duration
	local expiresAt = INF
	if duration ~= nil then
		if type(duration) ~= "number" or duration <= 0 or duration ~= duration then
			error("Modifier `duration` must be a positive number (or nil for permanent)", 2)
		end
		if duration ~= INF then
			expiresAt = Ticker.Now() + duration
		end
	end

	local key = def.key
	if key ~= nil then
		local stacking = def.stacking or "Replace"
		for _, existing in rec.mods do
			if existing.Source == source and existing.Key == key then
				if stacking == "Ignore" then
					return existing
				elseif stacking == "Refresh" then
					if duration ~= nil then
						self:_SetExpiryAbsolute(existing, expiresAt)
					end
					return existing
				elseif stacking == "Stack" then
					existing.Stacks = math.min(existing.Stacks + 1, def.maxStacks or INF)
					existing.Value = value
					if duration ~= nil then
						self:_SetExpiryAbsolute(existing, expiresAt)
					end
				else -- Replace
					existing.Type = mtype
					existing.Value = value
					existing.Stacks = 1
					existing.Priority = def.priority or 0
					self:_SetCondition(rec, existing, def.condition)
					self:_SetExpiryAbsolute(existing, expiresAt)
				end
				self:_MarkDirty(rec)
				return existing
			end
		end
	end

	self._nextId += 1
	local mod = setmetatable({
		Id = self._nextId,
		Stat = statName,
		Type = mtype,
		Value = value,
		Source = source,
		Key = key,
		Stacks = 1,
		Priority = def.priority or 0,
		Condition = nil,
		ExpiresAt = INF,
		_owner = self,
		_timed = false,
	}, Modifier)

	table.insert(rec.mods, mod)
	self:_SetCondition(rec, mod, def.condition)
	if expiresAt ~= INF then
		self:_SetExpiryAbsolute(mod, expiresAt)
	end
	self:_MarkDirty(rec)

	return mod
end

function StatContainer:_RemoveModifier(mod)
	mod._owner = nil
	local rec = self._records[mod.Stat]
	if rec == nil then
		return
	end
	local index = table.find(rec.mods, mod)
	if index ~= nil then
		table.remove(rec.mods, index)
	end
	if mod.Condition ~= nil then
		rec.conditionalCount -= 1
		if rec.conditionalCount <= 0 then
			self._conditional[rec] = nil
		end
	end
	self:_MarkDirty(rec)
end

function StatContainer:RemoveModifier(mod): boolean
	return mod:Remove()
end

-- Remove every modifier applied by `source` (optionally only on one stat). Returns the count.
function StatContainer:RemoveBySource(source: any, statName: string?): number
	local targets = {}
	for name, rec in self._records do
		if statName == nil or name == statName then
			for _, mod in rec.mods do
				if mod.Source == source then
					targets[#targets + 1] = mod
				end
			end
		end
	end
	for _, mod in targets do
		self:_RemoveModifier(mod)
	end
	return #targets
end

function StatContainer:HasSource(source: any, statName: string?): boolean
	for name, rec in self._records do
		if statName == nil or name == statName then
			for _, mod in rec.mods do
				if mod.Source == source then
					return true
				end
			end
		end
	end
	return false
end

-- Copy of the modifier handles of a stat.
function StatContainer:GetModifiers(statName: string): { any }
	return table.clone(self:_GetRecord(statName).mods)
end

-- Called by the Ticker.
function StatContainer:_Expire(now: number)
	local keep = {}
	local expired = nil
	local nextExpiry = INF

	for _, mod in self._timed do
		if mod._owner == nil or mod.ExpiresAt == INF then
			mod._timed = false
		elseif mod.ExpiresAt <= now then
			mod._timed = false
			expired = expired or {}
			table.insert(expired, mod)
		else
			table.insert(keep, mod)
			if mod.ExpiresAt < nextExpiry then
				nextExpiry = mod.ExpiresAt
			end
		end
	end

	self._timed = keep
	self._nextExpiry = nextExpiry
	if #keep == 0 then
		Ticker.Remove(self)
	end

	if expired ~= nil then
		for _, mod in expired do
			self:_RemoveModifier(mod)
		end
	end
end

--------------------------------------------------------------------------------
-- Observing
--------------------------------------------------------------------------------

-- callback(new, old) is called immediately with (value, value), then on every change.
function StatContainer:Observe(name: string, callback: (new: number, old: number) -> ())
	local rec = self:_GetRecord(name)
	if rec.signal == nil then
		rec.signal = Signal.new()
	end
	local value = self:Get(name)
	callback(value, value)
	return rec.signal:Connect(callback)
end

-- Signal(new, old) for one stat.
function StatContainer:GetChangedSignal(name: string)
	local rec = self:_GetRecord(name)
	if rec.signal == nil then
		rec.signal = Signal.new()
	end
	return rec.signal
end

--------------------------------------------------------------------------------
-- Replication helpers
--------------------------------------------------------------------------------

-- { [stat] = finalValue }  (modifiers are NOT replicated, only results)
function StatContainer:Serialize(): { [string]: number }
	return self:GetAll()
end

-- CLIENT side: the server's final values become the base values here.
function StatContainer:ApplySnapshot(values: { [string]: number })
	for name, value in values do
		local rec = self._records[name]
		if rec == nil then
			self:Define(name, { base = value })
		elseif rec.formula == nil then
			self:SetBase(name, value)
		end
	end
end

--------------------------------------------------------------------------------
-- Debug / lifecycle
--------------------------------------------------------------------------------

function StatContainer:Dump(): string
	local names = {}
	for name in self._records do
		names[#names + 1] = name
	end
	table.sort(names)

	local lines = {}
	for _, name in names do
		local info = self:Breakdown(name)
		lines[#lines + 1] = string.format(
			"%s = %.3f   (base %.3f | flat %+.3f | increase %+.0f%% | mult x%.3f | %d modifiers)",
			name,
			info.Value,
			info.Base,
			info.Flat,
			info.Increase * 100,
			info.Mult,
			#info.Modifiers
		)
	end
	if #lines == 0 then
		return "(no stats)"
	end
	return table.concat(lines, "\n")
end

function StatContainer:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	Ticker.Remove(self)
	if self._tagConnection ~= nil then
		self._tagConnection:Disconnect()
		self._tagConnection = nil
	end
	for _, rec in self._records do
		for _, mod in rec.mods do
			mod._owner = nil
		end
		if rec.signal ~= nil then
			rec.signal:Destroy()
		end
	end
	self._records = {}
	self._pending = {}
	self._timed = {}
	self._conditional = {}
	self.Changed:Destroy()
end

return StatContainer
]]></ProtectedString>
</Properties>
</Item>
</Item>
</roblox>
